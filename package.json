{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check-types": "npm run check-types:web && npm run check-types:trigger",
    "check-types:trigger": "npm run check-types -w apps/trigger",
    "check-types:web": "npm run check-types -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "lint": "eslint",
    "sort-package-json": "sort-package-json package.json apps/*/package.json packages/*/package.json"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "15.5.6",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.6",
    "eslint-plugin-react-hooks": "7.0.1",
    "markdown-toc": "1.2.0",
    "sort-package-json": "3.4.0",
    "tsx": "4.20.6",
    "turbo": "2.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "packageManager": "pnpm@10.16.1"
}
