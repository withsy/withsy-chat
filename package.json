  "private": true,
  "scripts": {
    "build": "next build",
    "cli": "tsx src/server/cli.ts",
    "db:migrate": "npm run db:migrate:core && npm run db:migrate:worker",
    "db:migrate:core": "prisma migrate deploy",
    "db:migrate:worker": "dotenvx run -- tsx scripts/migrate-worker.ts",
    "db:reset": "psql -h 127.0.0.1 -U postgres -f dev/reset.sql",
    "db:seed": "psql -h 127.0.0.1 -U postgres -f dev/seed.sql",
    "db:setup": "npm run db:reset && npm run db:migrate && npm run db:seed",
    "dev": "dotenvx run -- next dev --turbopack",
    "lint": "next lint",
    "start": "dotenvx run -- next start",
    "typecheck": "tsc"
  },
