{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check-types": "npm run check-types:web && npm run check-types:trigger",
    "check-types:trigger": "npm run check-types -w apps/trigger",
    "check-types:web": "npm run check-types -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "dev:api": "turbo dev --filter=@repo/common --filter=@repo/api",
    "dev:web": "turbo dev --filter=@repo/web",
    "lint": "eslint",
    "sort-package-json": "sort-package-json package.json apps/*/package.json packages/*/package.json"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "15.5.6",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.6",
    "eslint-plugin-react-hooks": "7.0.1",
    "markdown-toc": "1.2.0",
    "pnpm-upgrade-interactive": "1.1.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "sort-package-json": "3.6.0",
    "turbo": "2.6.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
