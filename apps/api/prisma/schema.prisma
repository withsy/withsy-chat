generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  engineType      = "client"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                String             @id @map("id") @db.Uuid
  preferences       Json               @default("{}") @map("preferences")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  userLinkAccounts  UserLinkAccount[]  @relation("UserLinkAccount.userId")
  userUsageLimits   UserUsageLimit[]   @relation("UserUsageLimit.userId")
  userPrompts       UserPrompt[]       @relation("UserPrompt.userId")
  userDefaultPrompt UserDefaultPrompt? @relation("UserDefaultPrompt.userId")
  chats             Chat[]             @relation("Chat.userId")

  @@map("users")
}

model UserLinkAccount {
  id                Int      @id @default(autoincrement()) @map("id")
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation("UserLinkAccount.userId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  provider          String   @map("provider")
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_link_accounts")
}

model UserUsageLimit {
  id              Int      @id @default(autoincrement()) @map("id")
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation("UserUsageLimit.userId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type            String   @map("type")
  period          String   @map("period")
  remainingAmount Int      @map("remaining_amount")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, type, period])
  @@map("user_usage_limits")
}

model UserPrompt {
  id                 String              @id @map("id") @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  user               User                @relation("UserPrompt.userId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  titleEncrypted     String              @map("title_encrypted")
  textEncrypted      String              @map("text_encrypted")
  isStarred          Boolean             @default(false) @map("is_starred")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  userDefaultPrompts UserDefaultPrompt[] @relation("UserDefaultPrompt.userPromptId")
  chats              Chat[]              @relation("Chat.userPromptId")

  @@index([userId])
  @@map("user_prompts")
}

model UserDefaultPrompt {
  id           Int         @id @default(autoincrement()) @map("id")
  userId       String      @unique @map("user_id") @db.Uuid
  user         User        @relation("UserDefaultPrompt.userId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userPromptId String?     @map("user_prompt_id") @db.Uuid
  userPrompt   UserPrompt? @relation("UserDefaultPrompt.userPromptId", fields: [userPromptId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_default_prompts")
}

model Chat {
  id             String        @id @map("id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation("Chat.userId", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  titleEncrypted String        @map("title_encrypted")
  isStarred      Boolean       @default(false) @map("is_starred")
  userPromptId   String?       @map("user_prompt_id") @db.Uuid
  userPrompt     UserPrompt?   @relation("Chat.userPromptId", fields: [userPromptId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  chatMessages   ChatMessage[] @relation("ChatMessage.chatId")

  @@index([userId])
  @@map("chats")
}

enum ChatMessageStatus {
  pending
  processing
  succeeded
  failed
}

model ChatMessage {
  id                String             @id @map("id") @db.Uuid
  chatId            String             @map("chat_id") @db.Uuid
  chat              Chat               @relation("ChatMessage.chatId", fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role              String             @map("role")
  textEncrypted     String             @map("text_encrypted")
  isBookmarked      Boolean            @default(false) @map("is_bookmarked")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  chatChunks        ChatChunk[]        @relation("ChatChunk.chatMessageId")
  chatMessageAiInfo ChatMessageAiInfo? @relation("ChatMessageAiInfo.chatMessageId")

  @@map("chat_messages")
}

model ChatMessageAiInfo {
  id                     String            @id @map("id") @db.Uuid
  chatMessageId          String            @unique @map("chat_message_id") @db.Uuid
  chatMessage            ChatMessage       @relation("ChatMessageAiInfo.chatMessageId", fields: [chatMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  model                  String            @map("model")
  reasoningTextEncrypted String            @map("reasoning_text_encrypted")
  status                 ChatMessageStatus @default(pending) @map("status")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("chat_message_ai_infos")
}

model ChatChunk {
  id                     Int         @id @default(autoincrement()) @map("id")
  chatMessageId          String      @map("chat_message_id") @db.Uuid
  chatMessage            ChatMessage @relation("ChatChunk.chatMessageId", fields: [chatMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  index                  Int         @map("index")
  rawDataEncrypted       String      @map("raw_data_encrypted")
  textEncrypted          String      @map("text_encrypted")
  reasoningTextEncrypted String      @map("reasoning_text_encrypted")
  isSuccess              Boolean?    @map("is_success")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([chatMessageId, index])
  @@map("chat_chunks")
}

model IdempotencyKey {
  id             Int      @id @default(autoincrement()) @map("id")
  idempotencyKey String   @unique @map("idempotency_key") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model ApiKey {
  id        Int      @id @default(autoincrement()) @map("id")
  apiKey    String   @unique @map("api_key")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("api_keys")
}

model SupabaseActivity {
  id        Int      @id @map("id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("supabase_activities")
}
